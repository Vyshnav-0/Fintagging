# Port for the backend server to run on
PORT=5000

# Environment (development or production)
NODE_ENV=development

# --- AI Service Keys ---

# Google Gemini API Key (Required for primary AI features)
GEMINI_API_KEY=

# OpenRouter API Key (Optional fallback or alternative to Gemini)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=FinTagging

# Hugging Face API Key (Optional, for dataset evaluation features)
HUGGINGFACE_API_KEY=

# --- Security & Auth ---

# JWT Secret Key (Required for authentication)
JWT_SECRET=your_very_secret_key_here
# JWT expiration time (e.g., 7d, 24h, 30m)
JWT_EXPIRES_IN=7d
# OTP expiration time in minutes
OTP_EXPIRY_MINUTES=10

# --- Email Service (Gmail) ---

# Gmail address used to send OTP tokens
EMAIL_USER=
# Gmail App Password (NOT your regular password)
EMAIL_PASSWORD=

# --- Server & CORS ---

# Allowed CORS origins (e.g., http://localhost:3000 or * for all)
ALLOWED_ORIGIN=*

# Maximum file upload size in MB
MAX_FILE_SIZE_MB=10

# --- Database ---

# MongoDB connection string (Optional, app uses local storage by default)
# MONGODB_URI=mongodb://localhost:27017/fintagging
# USE_MEMORY_STORAGE=true

# --- Analysis Settings ---

# Toggle local rule-based extraction (true/false)
# Set to true to bypass AI and use regex extraction for testing/cost saving
USE_LOCAL_EXTRACTION=false

# Timeouts for API calls (in milliseconds)
LLM_TIMEOUT_MS=120000
OPENROUTER_MODEL_TIMEOUT_MS=25000
